# Subte — variables de entorno
# Copiá este archivo a .env.local para desarrollo. Nunca subas valores reales al repositorio.

# URL del proyecto de Supabase (Settings > API > Project URL). Pública.
NEXT_PUBLIC_SUPABASE_URL=

# Clave anónima (anon / publishable) de Supabase. Pública; el acceso está limitado por RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave service role de Supabase. SECRETA: se salta RLS. Solo se usa en el servidor
# (Server Actions de /admin y escritura en la tabla logs).
SUPABASE_SERVICE_ROLE_KEY=

# Clave compartida de operadores. SECRETA. Protege /admin.
# Generala con: openssl rand -base64 32
OPERATOR_KEY=

# Clave de Vercel AI Gateway para la traducción. SECRETA y OPCIONAL:
# en Vercel no hace falta (se autentica con OIDC). Solo para correr fuera de Vercel.
AI_GATEWAY_API_KEY=
